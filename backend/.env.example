# Copy to .env  (or run: python -m scripts.init_env  which fills the secrets for you)
ENV=dev
DATABASE_URL=postgresql+psycopg2://scholarship:scholarship@localhost:5432/scholarship
MONGO_URL=mongodb://localhost:27017
MONGO_DB=scholarship
JWT_SECRET=change-me-long-random
JWT_EXPIRE_MINUTES=60
# Fernet key for bank details. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
DOC_LINK_TTL_SECONDS=600
RATE_LIMIT_ENABLED=true
MAIL_BACKEND=console          # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@scholarship.local
